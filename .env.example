# Copy to .env and fill it in. Never commit .env.
# Required by every /v1/* route (header X-API-Key). Without it those routes answer 503 (fail closed).
API_KEY=change-me
# API settings (src/fundos_api/config.py). The warehouse is opened read-only and never created.
DUCKDB_PATH=data/warehouse.duckdb
MARTS_SCHEMA=marts
API_PREFIX=/v1
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
# Per-key rate limit, fixed window, per API process (RF-10).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
